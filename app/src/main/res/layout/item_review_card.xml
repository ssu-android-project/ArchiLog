<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="16dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="6dp"
    app:cardUseCompatPadding="false"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 상단 이미지 -->
        <ImageView
            android:id="@+id/imgPlace"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:src="@drawable/img_ecc" />

        <!-- 제목 -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:text="서울 건축 답사 3"
            android:textSize="16sp"
            android:fontFamily="@font/pretendard_bold" />

        <!-- 위치 -->
        <TextView
            android:id="@+id/tvLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:text="서울특별시 종로구"
            android:textSize="13sp"
            android:textColor="#666666"
            android:fontFamily="@font/pretendard_extra_light" />

        <!-- 날짜 -->
        <TextView
            android:id="@+id/tvDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="2dp"
            android:text="2024. 11. 12 방문"
            android:textSize="12sp"
            android:textColor="#888888"
            android:fontFamily="@font/pretendard_extra_light" />

        <!-- 별점 + 태그 2개 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp">

            <!-- 별점 -->
            <TextView
                android:id="@+id/tvRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⭐ 4.5"
                android:textSize="14sp"
                android:fontFamily="@font/pretendard_semi_bold"/>

            <!-- 태그 하나 -->
            <TextView
                android:id="@+id/tag1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:background="@drawable/tag_background"
                android:text="브루탈리즘"
                android:textSize="12sp"
                android:textColor="#333333"
                android:fontFamily="@font/pretendard_semi_bold" />

            <!-- 태그 둘 -->
            <TextView
                android:id="@+id/tag2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:background="@drawable/tag_background"
                android:text="노출 콘크리트"
                android:textSize="12sp"
                android:textColor="#333333"
                android:fontFamily="@font/pretendard_semi_bold" />

        </LinearLayout>

        <!-- 한 줄 요약 -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="16dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="자연광이 건물 내부로 깊게 들어오는 설계가 인상적이었던 장소."
            android:textColor="#444444"
            android:fontFamily="@font/pretendard_thin"/>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>