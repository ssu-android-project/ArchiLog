<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- Top Bar -->
    <RelativeLayout
        android:id="@+id/layoutTopBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="✕"
            android:textSize="22sp"
            android:fontFamily="@font/pretendard_semi_bold"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="답사 캘린더"
            android:textSize="18sp"
            android:fontFamily="@font/pretendard_bold"/>
    </RelativeLayout>

    <!-- Month Row -->
    <LinearLayout
        android:id="@+id/layoutMonthRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toBottomOf="@id/layoutTopBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnPrev"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="‹"
            android:textSize="22sp"
            android:fontFamily="@font/pretendard_semi_bold"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/tvMonth"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="2025.12"
            android:textSize="26sp"
            android:fontFamily="@font/pretendard_bold" />

        <TextView
            android:id="@+id/btnNext"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="›"
            android:textSize="22sp"
            android:fontFamily="@font/pretendard_semi_bold"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- Weekday Row -->
    <LinearLayout
        android:id="@+id/layoutWeekRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="15dp"
        app:layout_constraintTop_toBottomOf="@id/layoutMonthRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView style="@style/WeekDayText" android:text="일"/>
        <TextView style="@style/WeekDayText" android:text="월"/>
        <TextView style="@style/WeekDayText" android:text="화"/>
        <TextView style="@style/WeekDayText" android:text="수"/>
        <TextView style="@style/WeekDayText" android:text="목"/>
        <TextView style="@style/WeekDayText" android:text="금"/>
        <TextView style="@style/WeekDayText" android:text="토"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCalendar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingHorizontal="12dp"
        android:paddingBottom="12dp"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/layoutWeekRow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>