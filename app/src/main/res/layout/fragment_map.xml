<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".map.MapFragment">

    <!-- 지도 -->
    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 하단 시트 -->
    <LinearLayout
        android:id="@+id/bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="450dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_sheet"
        android:elevation="8dp"
        android:orientation="vertical"
        android:clipToOutline="true"
        app:layout_behavior="@string/bottom_sheet_behavior"
        app:behavior_peekHeight="0dp"
        app:behavior_fitToContents="true"
        tools:visibility="visible"
        android:clickable="true">

        <!-- 건물 이미지 -->
        <ImageView
            android:id="@+id/imgBuilding"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:src="@drawable/sample_building"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!-- 제목 -->
            <TextView
                android:id="@+id/tvBuildingName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="4dp"
                android:text="건축물 이름"
                android:textSize="16sp"
                android:fontFamily="@font/pretendard_extra_bold" />

            <!-- 건축가 이름 -->
            <TextView
                android:id="@+id/tvArchitectName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="4dp"
                android:text="건축가 이름"
                android:textSize="14sp"
                android:fontFamily="@font/pretendard_semi_bold" />

            <!-- 설명 -->
            <TextView
                android:id="@+id/tvBuildingDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp"
                android:text="간단한 설명이 들어갑니다."
                android:textSize="12sp"
                android:fontFamily="@font/pretendard_extra_light" />

            <!-- 상세보기 버튼 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetail"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="상세보기"
                android:textSize="14sp"
                android:fontFamily="@font/pretendard_extra_bold"
                android:textColor="@color/black"
                app:backgroundTint="@color/white"
                app:cornerRadius="12dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/black" />

        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>